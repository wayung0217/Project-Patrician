+func _zone_built_ratio_ok(port_id: String, next_zone: int) -> bool:
+	## FRM-SYS08-16 D-100: built／total ≥ ZONE_USED_MIN_PPM／PPM_SCALE for zones 1..k−1.
+	if not Params.has_prm(PRM_ZONE_USED_MIN_PPM):
