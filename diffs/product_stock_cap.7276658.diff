-			if String(pid_v) == port_s:
-				port_known = true
-				break
-		if port_known:
-			var stock_cap: int = GoodsLedger.get_qty(GoodsLedger.make_market(port_s), good)
-			if stock_cap < 1:
-				return 0
-			abs_hi = stock_cap + 1
+		var stock_cap: int = GoodsLedger.get_qty(GoodsLedger.make_market(port_s), good)
+		if stock_cap < 1:
+			return 0
+		abs_hi = stock_cap + 1
 	# 擴張上界：hi 倍增直到 total > bal 或 quote 失敗（或碰到庫存上界）
