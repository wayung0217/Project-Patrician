+	var g_s := String(good_id)
+	cargo[g_s] = int(cargo.get(g_s, 0)) + qty
+	_season_margin_sum[key] = int(_season_margin_sum.get(key, 0)) + daily_margin_li
+	_season_margin_n[key] = int(_season_margin_n.get(key, 0)) + 1
+
