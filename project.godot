; Engine configuration file.
; Godot 4.7.2-stable — Autoload order 2.2-01／D-14c／D-26b／D-17d／D-09a／D-34d:
; … → CashLedger → TradeDesk → BuildingEconomy → … → ShipRegistry → IntelLedger → SimLoop
; （BrokerDesk／TraderRegistry／TierRegistry／ReputationLedger／TaxLedger 尚未實作）.

config_version=5

[application]

config/name="Project Patrician"
config/features=PackedStringArray("4.7")
run/main_scene="res://ui/debug_main.tscn"

[autoload]

Params="*res://autoload/params.gd"
Clock="*res://autoload/clock.gd"
GoodCatalog="*res://autoload/good_catalog.gd"
PortRegistry="*res://autoload/port_registry.gd"
SeaLanes="*res://autoload/sea_lanes.gd"
GoodsLedger="*res://autoload/goods_ledger.gd"
MarketPricer="*res://autoload/market_pricer.gd"
CashLedger="*res://autoload/cash_ledger.gd"
TradeDesk="*res://autoload/trade_desk.gd"
BuildingEconomy="*res://autoload/building_economy.gd"
PopulationModel="*res://autoload/population_model.gd"
DemandModel="*res://core/demand_model.gd"
ShipRegistry="*res://autoload/ship_registry.gd"
IntelLedger="*res://autoload/intel_ledger.gd"
SimLoop="*res://autoload/sim_loop.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")
