; Engine configuration file.
; Godot 4.7.2-stable — Autoload order D-14c／D-17d: … → BuildingEconomy → PopulationModel → SimLoop.
; ShipRegistry (D-14c) is WP-30 — not registered in this WP.

config_version=5

[application]

config/name="Project Patrician"
config/features=PackedStringArray("4.7")

[autoload]

Params="*res://autoload/params.gd"
Clock="*res://autoload/clock.gd"
GoodCatalog="*res://autoload/good_catalog.gd"
PortRegistry="*res://autoload/port_registry.gd"
SeaLanes="*res://autoload/sea_lanes.gd"
GoodsLedger="*res://autoload/goods_ledger.gd"
MarketPricer="*res://autoload/market_pricer.gd"
CashLedger="*res://autoload/cash_ledger.gd"
BuildingEconomy="*res://autoload/building_economy.gd"
PopulationModel="*res://autoload/population_model.gd"
SimLoop="*res://autoload/sim_loop.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")
