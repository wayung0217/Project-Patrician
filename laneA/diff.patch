+	_loaded = false
+	_enabled = false
+	_qual_open = false
+	_genesis_granted = false
+	_last_error = {}
+	_traders.clear()
+	_frozen.clear()
+	_voyage_days.clear()
+	_curve_weeks = PackedFloat64Array()
+	_curve_mults = PackedFloat64Array()
+	_pending_signals.clear()
+	_day_errors.clear()
