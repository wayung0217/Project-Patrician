name: CI

# 17-64 S1: one full CI per commit on pull_request; push only main + tools-1758 + int-1758.
on:
  pull_request:
  push:
    branches:
      - main
      - tools-1758
      - int-1758
  workflow_dispatch:
    inputs:
      job:
        description: "Manual job (H4 smoke / W4 inline-cmp / default all CI)"
        required: true
        default: "ci"
        type: choice
        options:
          - ci
          - h4-smoke
          - w4-inline-cmp

# 17-64／17-67 S2: one concurrency group per head branch so push+PR cancel each other.
# github.ref differs (refs/heads/X vs refs/pull/N/merge) — use head_ref || ref_name.
concurrency:
  group: ${{ github.workflow }}-${{ github.head_ref || github.ref_name }}
  cancel-in-progress: true

env:
  GODOT_VERSION: "4.7.2-stable"
  GODOT_BIN: Godot_v4.7.2-stable_linux.x86_64

jobs:
  # 17-64 S4: parallel gut-unit / gut-ui / golden; unit matrix 4-way when wall >10m.
  gut-unit:
    if: github.event_name != 'workflow_dispatch' || inputs.job == 'ci'
    runs-on: ubuntu-latest
    # 17-67／R9-73: shard0+property wall. bb1b50d hit 30m; e99b495 hit 35m (cancelled).
    # Raise to 45 — whole-CI wall still ≤50m under parallel jobs (other shards ≪10m).
    timeout-minutes: 45
    strategy:
      fail-fast: false
      matrix:
        shard: [0, 1, 2, 3]
    steps:
      - name: Checkout
        uses: actions/checkout@v7

      - name: Cache Godot binary
        id: cache-godot
        uses: actions/cache@v6
        with:
          path: godot
          key: godot-${{ env.GODOT_VERSION }}-linux-x86_64

      - name: Download Godot 4.7.2-stable
        if: steps.cache-godot.outputs.cache-hit != 'true'
        run: |
          set -euo pipefail
          curl -fsSL -o godot.zip \
            "https://github.com/godotengine/godot/releases/download/${GODOT_VERSION}/${GODOT_BIN}.zip"
          unzip -q godot.zip
          rm -f godot.zip
          chmod +x "${GODOT_BIN}"
          mv "${GODOT_BIN}" godot
          ./godot --version

      - name: Ensure godot executable
        run: |
          set -euo pipefail
          chmod +x godot
          ./godot --version

      - name: tools/*.ps1 must be pure ASCII
        if: matrix.shard == 0
        run: |
          set -euo pipefail
          fail=0
          shopt -s nullglob
          for f in tools/*.ps1; do
            if LC_ALL=C grep -n '[^[:print:][:space:]]' "$f" >/tmp/ps1_nonascii.txt; then
              echo "::error::non-ASCII bytes in $f"
              cat /tmp/ps1_nonascii.txt
              fail=1
            fi
            if python3 -c "import sys; b=open(sys.argv[1],'rb').read(); sys.exit(0 if all(x<128 for x in b) else 1)" "$f"; then
              echo "ASCII_OK $f"
            else
              echo "::error::byte>127 in $f"
              python3 -c "b=open('$f','rb').read(); print([(i,b[i]) for i in range(len(b)) if b[i]>127][:20])"
              fail=1
            fi
          done
          exit "$fail"

      # 17-64 S3: cache .godot/imported (never test/golden outputs).
      - name: Cache Godot imported assets
        uses: actions/cache@v6
        with:
          path: .godot/imported
          key: godot-imported-${{ hashFiles('project.godot', '**/*.import', 'data/**') }}
          restore-keys: |
            godot-imported-

      - name: Import project (register global classes)
        run: |
          set -euo pipefail
          ./godot --headless --path . --import

      # 17-64 T1: Godot 4.7.2 gut .import must leave a clean tree.
      # Ignore download artifacts (godot.zip / godot binary) left in the workspace.
      - name: Assert import leaves clean tree
        run: |
          set -euo pipefail
          dirty="$(git status --porcelain | awk '!($1=="??" && ($2=="godot" || $2=="godot.zip"))' || true)"
          if [[ -n "${dirty}" ]]; then
            echo "::error::godot --import dirtied the working tree (commit missing .import / .uid)"
            echo "$dirty"
            git diff --stat
            exit 1
          fi
          echo "IMPORT_CLEAN_TREE_OK"

      - name: Select unit shard scripts (size-balanced 4-way) + property on shard 0
        id: shard
        run: |
          set -euo pipefail
          SHARD="${{ matrix.shard }}"
          python3 - <<PY
          from pathlib import Path
          shard = int("${SHARD}")
          files = sorted(Path("tests/unit").glob("test_*.gd"), key=lambda p: (-p.stat().st_size, p.name))
          bins = [[] for _ in range(4)]
          sizes = [0] * 4
          for f in files:
              i = min(range(4), key=lambda k: sizes[k])
              bins[i].append(f)
              sizes[i] += f.stat().st_size
          selected = bins[shard]
          out = Path("/tmp/gut_shard_tests.txt")
          lines = [f"res://{p.as_posix()}" for p in sorted(selected, key=lambda p: p.name)]
          if shard == 0:
              for p in sorted(Path("tests/property").glob("test_*.gd")):
                  lines.append(f"res://{p.as_posix()}")
          out.write_text("\n".join(lines) + "\n")
          print(f"SHARD={shard} unit={len(selected)} bytes={sizes[shard]} scripts={len(lines)}")
          for ln in lines:
              print(ln)
          Path("/tmp/gut_shard_selected_unit.txt").write_text(str(len(selected)))
          PY
          echo "selected_unit=$(cat /tmp/gut_shard_selected_unit.txt)" >> "$GITHUB_OUTPUT"

      - name: Run GUT unit shard
        run: |
          set -euo pipefail
          # GUT -gtest takes full res:// paths (keeps original script locations).
          mapfile -t TESTS < /tmp/gut_shard_tests.txt
          if [[ ${#TESTS[@]} -eq 0 ]]; then
            echo "::error::shard selected zero scripts"
            exit 1
          fi
          GTEST_ARGS=()
          for t in "${TESTS[@]}"; do
            GTEST_ARGS+=("-gtest=${t}")
          done
          ./godot --headless --path . -s addons/gut/gut_cmdln.gd \
            -gconfig= \
            "${GTEST_ARGS[@]}" \
            -gexit 2>&1 | tee gut_unit.log
          if grep -F "SCRIPT ERROR" gut_unit.log; then
            echo "::error::SCRIPT ERROR detected in GUT unit/property log (ci-script-error-gate)"
            exit 1
          fi
          grep -E 'Passing Tests|Failing|All tests passed' gut_unit.log | tail -20 || true
          python3 - <<'PY'
          import re
          from pathlib import Path
          text = Path("gut_unit.log").read_text(errors="replace")
          m = re.findall(r"Passing Tests\s+(\d+)", text)
          n = int(m[-1]) if m else -1
          Path("gut_unit_passing.txt").write_text(f"{n}\n")
          print(f"SHARD_PASSING={n}")
          # Bare test names for 17-69 2.4 set-diff gate (unique across suite).
          # Strip ANSI — GUT prefixes the first test of each script with \x1b[0m
          # so ^\* alone under-counts and falsely lists REMOVED_NAMES.
          clean = re.sub(r"\x1b\[[0-9;]*m", "", text)
          names = sorted(set(re.findall(r"^\* (test_\w+)$", clean, flags=re.M)))
          Path("gut_unit_names.txt").write_text("\n".join(names) + ("\n" if names else ""))
          print(f"SHARD_NAMES={len(names)}")
          if n >= 0 and len(names) != n:
              print(f"::warning::SHARD_NAMES={len(names)} != SHARD_PASSING={n} (name parse drift)")
          PY
      - name: A35 norm scan (report-only, shard 0)
        if: matrix.shard == 0
        continue-on-error: true
        run: |
          set -euo pipefail
          python3 tools/a35_norm_scan.py

      - name: Upload GUT unit shard logs
        if: always()
        uses: actions/upload-artifact@v7
        with:
          name: gut-unit-logs-${{ matrix.shard }}
          path: |
            gut_unit.log
            gut_unit_passing.txt
            gut_unit_names.txt
          retention-days: 3

